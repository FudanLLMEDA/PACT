# Copy to .env and fill in. Loaded by FDAgents via python-dotenv.

# --- Heavy deps (referenced, not copied) ---
# Path to a built RapidWright checkout (the bundled submodule can be used):
RAPIDWRIGHT_PATH=/path/to/pact-artifact/RapidWright
# Vivado install root (the dir containing settings64.sh), for the Vivado MCP:
XILINX_VIVADO=/path/to/Xilinx/Vivado/2025.1
# Directory containing benchmark DCPs:
BENCHMARKS_DIR=/path/to/benchmarks

# --- LLM access ---
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint for non-OpenAI models (DeepSeek/Qwen/etc.)
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- Optional FDAgents defaults (configs usually set these per-experiment) ---
# FDAGENTS_MODEL=gpt-4o
# FDAGENTS_TOKEN_BUDGET=1.0
# FDAGENTS_MAX_ROUNDS=300
